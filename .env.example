# ---------------------------------------------------------------------------
# The Celebration Society — Warehouse Dashboard
# Copy this file to `.env` and fill in the values. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Database connection string.
#
# Local development (SQLite — the default):
DATABASE_URL="file:./dev.db"
#
# Hosted Postgres (Vercel Postgres / Neon / Supabase / RDS). To use this,
# also change `provider` in prisma/schema.prisma from "sqlite" to "postgresql":
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Password for the /admin page.
# The warehouse display at "/" stays public — no login needed on the TV.
# Change this before deploying anywhere the public can reach.
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie.
# Generate a fresh one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET="please-generate-a-long-random-string"

# ---------------------------------------------------------------------------
# FUTURE — Shopify integration (not used in V1; see docs/SHOPIFY-INTEGRATION.md)
# Leave these unset. They are listed here so the eventual integration has an
# obvious home and nobody has to reverse-engineer the variable names.
# ---------------------------------------------------------------------------
# SHOPIFY_STORE_DOMAIN="the-celebration-society.myshopify.com"
# SHOPIFY_ADMIN_ACCESS_TOKEN=""
# SHOPIFY_API_VERSION="2026-07"
# SHOPIFY_WEBHOOK_SECRET=""
